{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calshii",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pilani-predict",
      "database_id": "795136d3-f4bc-4054-a575-7b3a8058bcc1",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "pilani.bits-pilani.ac.in"
  },
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ADMIN_EMAILS
}
